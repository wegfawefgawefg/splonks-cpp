#!/usr/bin/env python3
import argparse
import json
import socket
import sys


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Query a live Splonks debug-control server."
    )
    parser.add_argument(
        "--port",
        "-p",
        type=int,
        default=41000,
        help="debug-control port, usually 41000 for host or 41001 for joiner",
    )
    parser.add_argument(
        "--host",
        default="127.0.0.1",
        help="debug-control host; game only binds localhost",
    )
    parser.add_argument(
        "--raw",
        action="store_true",
        help="print raw JSON line instead of pretty JSON",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="command to send: status, players, ents near 96, ent 0, tiles x y w h, net, perf, input 12 right jump",
    )
    args = parser.parse_args()

    command = " ".join(args.command).strip() or "status"
    with socket.create_connection((args.host, args.port), timeout=2.0) as sock:
        sock.sendall((command + "\n").encode("utf-8"))
        chunks: list[bytes] = []
        while True:
            data = sock.recv(65536)
            if not data:
                break
            chunks.append(data)

    response = b"".join(chunks).decode("utf-8", errors="replace").strip()
    if args.raw:
        print(response)
        return 0

    try:
        parsed = json.loads(response)
    except json.JSONDecodeError:
        print(response)
        return 1

    print(json.dumps(parsed, indent=2, sort_keys=True))
    return 0 if parsed.get("ok", False) else 1


if __name__ == "__main__":
    sys.exit(main())
