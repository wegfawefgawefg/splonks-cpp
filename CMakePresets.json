{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "dev",
      "displayName": "Debug (dev)",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPLONKS_MODE": "developer",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "package-linux",
      "displayName": "Linux Package",
      "binaryDir": "${sourceDir}/build-package-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "package-macos",
      "displayName": "macOS Package",
      "binaryDir": "${sourceDir}/build-package-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "package-windows",
      "displayName": "Windows Package",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-package-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "ios-sim",
      "displayName": "iOS Simulator",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-sim",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true
      }
    },
    {
      "name": "ios-device",
      "displayName": "iOS Device",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/ios-device",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_BUILD_TYPE": "Release",
        "SPLONKS_MODE": "release",
        "SPLONKS_STRICT": true,
        "SPLONKS_WARN_AS_ERROR": true,
        "SPLONKS_FETCH_DEPS": true,
        "SPLONKS_IOS_DEVELOPMENT_TEAM": "$env{SPLONKS_IOS_DEVELOPMENT_TEAM}",
        "SPLONKS_IOS_CODE_SIGN_IDENTITY": "$env{SPLONKS_IOS_CODE_SIGN_IDENTITY}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "package-linux",
      "configurePreset": "package-linux",
      "jobs": 0
    },
    {
      "name": "package-macos",
      "configurePreset": "package-macos",
      "jobs": 0
    },
    {
      "name": "package-windows",
      "configurePreset": "package-windows",
      "jobs": 0
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "jobs": 0
    },
    {
      "name": "ios-sim",
      "configurePreset": "ios-sim",
      "jobs": 0
    },
    {
      "name": "ios-device",
      "configurePreset": "ios-device",
      "jobs": 0
    }
  ]
}
